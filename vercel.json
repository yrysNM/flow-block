{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nuxtjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "NUXT_API_PROXY_TARGET"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/vercel-server.mjs",
      "functions": {
        "src/vercel-server.mjs": {
          "includeFiles": "native/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
