# FocusFlow local defaults. Copy the app examples before running the API or web app.
# apps/api/.env.example
# apps/web/.env.example
#
# These values are for local Docker Compose only. Do not use them in production.

DATABASE_URL=postgresql://focusflow:focusflow@localhost:5432/focusflow?schema=public
WEB_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# Required when NODE_ENV=production. At least 32 characters, and not a placeholder.
# SESSION_SECRET=
# COOKIE_SECURE=1
# Optional. Not required at startup. Unset or unknown keeps the assistant unconfigured. Not an API key.
# ASSISTANT_PROVIDER=unconfigured
NUXT_PUBLIC_API_BASE=/api
NUXT_API_PROXY_TARGET=http://127.0.0.1:3001
