# Local Docker Compose defaults. Replace the password outside local development.
DATABASE_URL=postgresql://focusflow:focusflow@localhost:5432/focusflow?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Required when NODE_ENV=production. At least 32 characters, and not a placeholder.
# SESSION_SECRET=
# COOKIE_SECURE=1
# Optional. Unset, empty, unconfigured, or an unknown name keeps the assistant unconfigured.
# It is not required to start the API, and it is not an API key.
# ASSISTANT_PROVIDER=unconfigured
