{
  "manifest_version": 3,
  "name": "FocusFlow",
  "short_name": "FocusFlow",
  "version": "0.1.0",
  "description": "FocusFlow shell. Task sync, focus sessions, and website blocking are not in this build.",
  "action": {
    "default_title": "FocusFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
